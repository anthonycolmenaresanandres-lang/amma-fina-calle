# Public Supabase browser configuration (never place the service-role key here).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase administration.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical HTTPS application origin.
NEXT_PUBLIC_APP_URL=https://finacalleos.com

# Server-only Stripe subscription billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RECURRING_PRICE_ID=

# Verified Bank of America Zelle display values (not bank credentials).
ZELLE_RECIPIENT_NAME=Amma ventures llc
ZELLE_RECIPIENT_HANDLE=ammaventuresvb@gmail.com
ZELLE_QR_IMAGE_URL=

# Bodega guest notes continue to the existing Fina Calle request recipient.
# Leave this empty until Bodega provides a confirmed recipient.
BODEGA_GUEST_NOTES_EMAIL=

# Bodega rewards remain off until the migration, launch dates and staff access are ready.
BODEGA_REWARDS_ENABLED=false

# Fina Calle Square OAuth connector. Start in Sandbox; switch all Square values together for Production.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_OAUTH_CALLBACK_URL=https://finacalleos.com/api/integrations/square/callback
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://finacalleos.com/api/integrations/square/webhook
# Generate with: openssl rand -base64 32
SQUARE_TOKEN_ENCRYPTION_KEY=
SQUARE_API_VERSION=2026-09-16

# Native Vercel Cron authorization, shared by the scheduled routes.
CRON_SECRET=
# Explicit Square-only opt-in. Keep false during traffic-only activation.
SQUARE_REFRESH_CRON_ENABLED=false

# Private Fina Calle traffic dashboard and verified Vercel Analytics drain.
# Dedicated Postgres only; never reuse the Supabase application database.
# Production fails closed without a durable store and a signed Web Analytics drain.
# Vercel Neon Marketplace with the TRAFFIC_DATABASE prefix injects this automatically.
TRAFFIC_DATABASE_DATABASE_URL=
# Manual dedicated Postgres fallback only (do not set if using the Neon integration).
TRAFFIC_DATABASE_URL=
TRAFFIC_DRAIN_SECRET=
TRAFFIC_REPORT_TOKEN=
TRAFFIC_TIMEZONE=America/New_York

# Daily production traffic email (07:12 EST / 08:12 EDT, for the previous Eastern day).
# Report-only credentials; no fallback to customer-request or pitch mail settings.
# Save in Production only; the cron fails closed until configured.
TRAFFIC_RESEND_API_KEY=
TRAFFIC_FROM_EMAIL=
TRAFFIC_MORNING_REPORT_EMAIL=

# Separate existing customer-request / pitch email configuration.
RESEND_API_KEY=
REQUESTS_FROM_EMAIL=
