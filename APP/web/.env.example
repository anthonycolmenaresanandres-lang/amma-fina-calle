# Public Supabase browser configuration (never place the service-role key here).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase administration.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical HTTPS application origin.
NEXT_PUBLIC_APP_URL=https://finacalleos.com

# Server-only Stripe subscription billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RECURRING_PRICE_ID=

# Verified Bank of America Zelle display values (not bank credentials).
ZELLE_RECIPIENT_NAME=Amma ventures llc
ZELLE_RECIPIENT_HANDLE=ammaventuresvb@gmail.com
ZELLE_QR_IMAGE_URL=

# Bodega guest notes continue to the existing Fina Calle request recipient.
# Leave this empty until Bodega provides a confirmed recipient.
BODEGA_GUEST_NOTES_EMAIL=

# Bodega rewards remain off until the migration, launch dates and staff access are ready.
BODEGA_REWARDS_ENABLED=false

# Fina Calle Square OAuth connector. Start in Sandbox; switch all Square values together for Production.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_OAUTH_CALLBACK_URL=https://finacalleos.com/api/integrations/square/callback
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://finacalleos.com/api/integrations/square/webhook
# Generate with: openssl rand -base64 32
SQUARE_TOKEN_ENCRYPTION_KEY=
SQUARE_API_VERSION=2026-09-16

# Vercel Cron authorization for automatic Square token renewal.
CRON_SECRET=

# Private Fina Calle admin traffic dashboard. Server-only.
# The app tries Vercel deployment OIDC automatically; set this only if the Web Analytics API rejects OIDC.
VERCEL_WEB_ANALYTICS_TOKEN=
# Optional team override; project IDs are fixed by the verified site registry.
VERCEL_WEB_ANALYTICS_TEAM_ID=

# Daily production traffic email (07:12 EST / 08:12 EDT, for the previous Eastern day).
# Set all three in Production; the cron fails closed until configured.
RESEND_API_KEY=
REQUESTS_FROM_EMAIL=
TRAFFIC_MORNING_REPORT_EMAIL=
